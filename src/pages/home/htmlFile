<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>ServeLink — Find Any Service You Need</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --brand: #C2410C;
      --brand-light: #FFF7ED;
      --brand-dark: #7C2D12;
      --ink: #1C1917;
      --muted: #78716C;
      --soft: #F5F5F4;
      --white: #FFFFFF;
      --border: #E7E5E4;
      --radius: 14px;
      --radius-sm: 8px;
    }

    html { scroll-behavior: smooth; }
    body { font-family: 'DM Sans', sans-serif; background: var(--white); color: var(--ink); line-height: 1.6; }

    .page { max-width: 1100px; margin: 0 auto; padding: 0 24px; }

    /* ── NAV ── */
    nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 18px 32px; border-bottom: 1px solid var(--border);
      background: var(--white); position: sticky; top: 0; z-index: 100;
    }
    .logo { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 900; color: var(--brand); text-decoration: none; }
    .logo span { color: var(--ink); }
    nav ul { list-style: none; display: flex; gap: 28px; }
    nav ul a { text-decoration: none; color: var(--muted); font-size: 14px; font-weight: 400; transition: color .2s; }
    nav ul a:hover { color: var(--ink); }
    .nav-btn {
      background: var(--brand); color: #fff; border: none;
      padding: 9px 22px; border-radius: 50px; font-size: 13px; font-weight: 500;
      cursor: pointer; font-family: 'DM Sans', sans-serif; transition: background .2s;
    }
    .nav-btn:hover { background: var(--brand-dark); }

    /* ── HERO ── */
    .hero {
      padding: 72px 0 56px;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 48px; align-items: center;
    }
    .hero-tag {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--brand-light); color: var(--brand);
      font-size: 12px; font-weight: 500; padding: 5px 13px;
      border-radius: 50px; margin-bottom: 20px;
    }
    .hero-tag::before { content: ''; width: 7px; height: 7px; background: var(--brand); border-radius: 50%; }
    h1 { font-family: 'Playfair Display', serif; font-size: 54px; line-height: 1.1; font-weight: 900; margin-bottom: 18px; }
    h1 em { color: var(--brand); font-style: normal; }
    .hero-sub { color: var(--muted); font-size: 16px; line-height: 1.7; margin-bottom: 28px; max-width: 440px; }
    .search-bar {
      display: flex; background: var(--soft); border-radius: 50px;
      padding: 6px 6px 6px 18px; gap: 8px; align-items: center; max-width: 460px;
    }
    .search-bar input {
      flex: 1; border: none; background: transparent; font-size: 14px;
      font-family: 'DM Sans', sans-serif; outline: none; color: var(--ink);
    }
    .search-bar input::placeholder { color: #A8A29E; }
    .search-bar button {
      background: var(--brand); color: #fff; border: none;
      padding: 9px 22px; border-radius: 50px; font-size: 13px; font-weight: 500;
      cursor: pointer; font-family: 'DM Sans', sans-serif; transition: background .2s;
    }
    .search-bar button:hover { background: var(--brand-dark); }
    .hero-stats { display: flex; gap: 28px; margin-top: 28px; }
    .stat { font-size: 13px; color: var(--muted); }
    .stat strong { display: block; font-size: 20px; font-weight: 500; color: var(--ink); }

    /* Hero visual collage */
    .hero-visual { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .hv-card { border-radius: var(--radius); overflow: hidden; position: relative; height: 170px; cursor: pointer; }
    .hv-card:first-child { grid-column: 1 / -1; height: 200px; }
    .hv-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
    .hv-card:hover img { transform: scale(1.05); }
    .hv-label {
      position: absolute; bottom: 10px; left: 10px;
      background: rgba(28,25,23,0.72); backdrop-filter: blur(4px);
      color: #fff; font-size: 12px; font-weight: 500; padding: 4px 11px; border-radius: 50px;
    }

    /* ── CATEGORIES ── */
    .categories { padding: 64px 0; }
    .section-head { text-align: center; margin-bottom: 40px; }
    .section-head h2 { font-family: 'Playfair Display', serif; font-size: 38px; font-weight: 700; margin-bottom: 8px; }
    .section-head p { color: var(--muted); font-size: 15px; }
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }
    .cat-card {
      border-radius: var(--radius); overflow: hidden; cursor: pointer;
      position: relative; height: 250px;
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .cat-card:hover { transform: translateY(-5px); box-shadow: 0 14px 36px rgba(0,0,0,0.16); }
    .cat-img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; display: block; }
    .cat-card:hover .cat-img { transform: scale(1.07); }
    .cat-overlay {
      position: absolute; bottom: 0; left: 0; right: 0; padding: 16px;
      background: linear-gradient(to top, rgba(15,10,5,0.85) 0%, transparent 100%);
    }
    .cat-name { color: #fff; font-size: 15px; font-weight: 500; }
    .cat-count { color: rgba(255,255,255,0.7); font-size: 12px; margin-top: 2px; }

    /* ── HOW IT WORKS ── */
    .hiw { padding: 64px 0; background: var(--soft); }
    .hiw-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 780px; margin: 0 auto; }
    .hiw-step { text-align: center; padding: 28px 20px; }
    .hiw-num {
      width: 46px; height: 46px; border-radius: 50%; background: var(--brand); color: #fff;
      font-size: 18px; font-weight: 700; display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px;
    }
    .hiw-step h3 { font-size: 15px; font-weight: 500; margin-bottom: 7px; }
    .hiw-step p { font-size: 13px; color: var(--muted); line-height: 1.65; }

    /* ── CTA BANNER ── */
    .cta { padding: 72px 0; text-align: center; background: var(--ink); }
    .cta h2 { font-family: 'Playfair Display', serif; font-size: 40px; font-weight: 700; color: #fff; margin-bottom: 12px; }
    .cta p { color: #A8A29E; font-size: 15px; margin-bottom: 30px; }
    .cta-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
    .btn-white {
      background: #fff; color: var(--ink); border: none;
      padding: 13px 30px; border-radius: 50px; font-size: 14px; font-weight: 500;
      cursor: pointer; font-family: 'DM Sans', sans-serif; transition: opacity .2s;
    }
    .btn-white:hover { opacity: .88; }
    .btn-outline {
      background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.3);
      padding: 13px 30px; border-radius: 50px; font-size: 14px; font-weight: 500;
      cursor: pointer; font-family: 'DM Sans', sans-serif; transition: border-color .2s;
    }
    .btn-outline:hover { border-color: rgba(255,255,255,0.65); }

    /* ── FOOTER ── */
    footer { padding: 24px; text-align: center; color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); }

    /* ── PROVIDER VIEW ── */
    .provider-section { display: none; padding: 48px 0; animation: fadeIn .3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .back-btn {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--soft); border: none; border-radius: 50px;
      padding: 9px 18px; font-size: 13px; font-weight: 500;
      cursor: pointer; font-family: 'DM Sans', sans-serif; color: var(--ink);
      margin-bottom: 30px; transition: background .2s;
    }
    .back-btn:hover { background: var(--border); }
    .prov-head { margin-bottom: 30px; }
    .prov-head h2 { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; }
    .prov-head p { color: var(--muted); font-size: 14px; margin-top: 5px; }
    .prov-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px; }
    .prov-card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 20px;
      cursor: pointer; transition: box-shadow .2s, transform .2s;
    }
    .prov-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-3px); }
    .prov-avatar {
      width: 58px; height: 58px; border-radius: 50%; object-fit: cover;
      margin-bottom: 13px; border: 3px solid var(--brand-light); display: block;
    }
    .prov-name { font-size: 15px; font-weight: 500; margin-bottom: 3px; }
    .prov-title { font-size: 12px; color: var(--brand); font-weight: 500; margin-bottom: 7px; }
    .prov-desc { font-size: 13px; color: var(--muted); line-height: 1.55; }
    .prov-stars { font-size: 13px; color: #D97706; margin-top: 10px; }
    .prov-badge {
      display: inline-block; background: var(--brand-light); color: var(--brand);
      font-size: 11px; padding: 3px 9px; border-radius: 50px; margin-top: 7px; font-weight: 500;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 768px) {
      .hero { grid-template-columns: 1fr; gap: 32px; padding: 48px 0 40px; }
      .hero-visual { display: none; }
      h1 { font-size: 38px; }
      .hiw-steps { grid-template-columns: 1fr; }
      nav ul { display: none; }
      .section-head h2 { font-size: 28px; }
      .cta h2 { font-size: 30px; }
    }
    @media (max-width: 480px) {
      h1 { font-size: 30px; }
      .hero-stats { flex-wrap: wrap; gap: 14px; }
    }
  </style>
</head>
