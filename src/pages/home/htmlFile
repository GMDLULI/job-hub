  /* ── RENDER CATEGORIES ── */
  function renderCategories() {
    const grid = document.getElementById('cat-grid');
    grid.innerHTML = categories.map((c, i) => `
      <div class="cat-card" onclick="showProviders(${i})" role="button" tabindex="0" aria-label="Browse ${c.name}">
        <img class="cat-img" src="${c.img}" alt="${c.name}" loading="lazy"/>
        <div class="cat-overlay">
          <div class="cat-name">${c.name}</div>
          <div class="cat-count">${c.count} providers</div>
        </div>
      </div>
    `).join('');
  }

  /* ── SHOW PROVIDER LIST ── */
  function showProviders(index) {
    const cat = categories[index];
    document.getElementById('home-view').style.display = 'none';
    const pv = document.getElementById('provider-view');
    pv.style.display = 'block';
    document.getElementById('prov-title').textContent = cat.name;
    document.getElementById('prov-subtitle').textContent = `${cat.count} professionals available in your area`;
    const grid = document.getElementById('prov-grid');
    grid.innerHTML = cat.providers.map(p => `
      <div class="prov-card">
        <img class="prov-avatar" src="${p.avatar}" alt="${p.name}" loading="lazy"/>
        <div class="prov-name">${p.name}</div>
        <div class="prov-title">${p.title}</div>
        <div class="prov-desc">${p.desc}</div>
        <div class="prov-stars">${p.stars}</div>
        ${p.badge ? `<div class="prov-badge">${p.badge}</div>` : ''}
      </div>
    `).join('');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ── GO BACK ── */
  function goBack() {
    document.getElementById('provider-view').style.display = 'none';
    document.getElementById('home-view').style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ── KEYBOARD SUPPORT FOR CATEGORY CARDS ── */
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.classList.contains('cat-card')) {
      e.target.click();
    }
  });

  renderCategories();
</script>
</body>
